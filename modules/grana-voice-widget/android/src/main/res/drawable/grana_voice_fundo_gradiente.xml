<?xml version="1.0" encoding="utf-8"?>
<!-- Gradiente horizontal oficial do fundo do ícone de marca (referência 2).
     O aro petróleo mantém o círculo legível sobre papéis de parede claros. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
  <gradient
      android:angle="0"
      android:startColor="@color/grana_marca_gradiente_inicio"
      android:endColor="@color/grana_marca_gradiente_fim"
      android:type="linear" />
  <stroke android:width="1dp" android:color="@color/grana_marca_escuro" />
</shape>

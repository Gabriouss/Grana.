<?xml version="1.0" encoding="utf-8"?>
<!-- Raio maior que qualquer altura real de botão vira cápsula de verdade —
     o Android recorta pro raio máximo possível (metade da menor dimensão)
     sozinho. Antes era 12dp (canto arredondado comum); virou cápsula a
     pedido do autor, pra igualar o formato da fileira real "Colar
     comprovante"/"Importar extrato"/"Escanear nota" (06/09/2026). Usado só
     em grana_central_widget.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@color/grana_widget_superficie_alta" />
  <stroke android:width="1dp" android:color="@color/grana_widget_regra" />
  <corners android:radius="999dp" />
</shape>

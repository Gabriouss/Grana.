<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de contas do mês: cabeçalho, a lista de contas (atrasadas de
     qualquer mês e pendentes do mês atual) e o rodapé com "+N contas". Até
     19/09/2026 mostrava UMA conta, a de vencimento mais antigo, e um único
     boleto atrasado prendia o widget nele. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grana_compromisso_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grana_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/grana_compromisso_titulo"
        android:textColor="@color/grana_widget_texto_suave"
        android:textSize="11sp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/grana_compromisso_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/grana_compromisso_proximo"
        android:textColor="@color/grana_widget_menta"
        android:textSize="8sp"
        android:textStyle="bold"
        android:maxLines="1" />
  </LinearLayout>

  <!-- A lista. A linha de exemplo aqui dentro só aparece na prévia do
       seletor de widgets: o provider limpa o contêiner antes de desenhar. -->
  <LinearLayout
      android:id="@+id/grana_compromisso_lista"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical">
    <include layout="@layout/grana_compromisso_linha" />
  </LinearLayout>

  <TextView
      android:id="@+id/grana_compromisso_vazio"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="6dp"
      android:text="@string/grana_compromisso_nada"
      android:textColor="@color/grana_widget_texto"
      android:textSize="15sp"
      android:textStyle="bold"
      android:maxLines="3"
      android:ellipsize="end"
      android:visibility="gone" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/grana_compromisso_mais"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/grana_widget_menta"
        android:textSize="8sp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/grana_compromisso_atualizado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atualizado agora"
        android:textColor="@color/grana_widget_texto_suave"
        android:textSize="8sp"
        android:maxLines="1" />
  </LinearLayout>
</LinearLayout>

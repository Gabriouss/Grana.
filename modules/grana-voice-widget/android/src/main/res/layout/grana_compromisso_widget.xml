<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grana_compromisso_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grana_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/grana_compromisso_titulo"
        android:textColor="@color/grana_widget_texto_suave"
        android:textSize="11sp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/grana_compromisso_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/grana_compromisso_proximo"
        android:textColor="@color/grana_widget_menta"
        android:textSize="8sp"
        android:textStyle="bold"
        android:maxLines="1" />
  </LinearLayout>

  <TextView
      android:id="@+id/grana_compromisso_descricao"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="6dp"
      android:text="Conta de energia"
      android:textColor="@color/grana_widget_texto"
      android:textSize="17sp"
      android:textStyle="bold"
      android:maxLines="2"
      android:ellipsize="end" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/grana_compromisso_valor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="R$ 120,00"
        android:textColor="@color/grana_widget_texto"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1" />
    <TextView
        android:id="@+id/grana_compromisso_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="vence amanhã"
        android:textColor="@color/grana_widget_texto_suave"
        android:textSize="10sp"
        android:maxLines="1" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/grana_compromisso_recorrente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/grana_compromisso_recorrente"
        android:textColor="@color/grana_widget_menta"
        android:textSize="8sp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/grana_compromisso_atualizado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atualizado agora"
        android:textColor="@color/grana_widget_texto_suave"
        android:textSize="8sp"
        android:maxLines="1" />
  </LinearLayout>
</LinearLayout>

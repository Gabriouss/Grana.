<?xml version="1.0" encoding="utf-8"?>
<!-- Lista vertical (ícone + rótulo por linha), não mais grade 2x2 de caixas —
     pra se parecer com o menu de "Novo lançamento" que já existe dentro do
     app (components/FabButton.tsx), como pedido depois que o widget saiu
     "muito ruim"/"paia" na primeira versão (04-05/09/2026). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grana_central_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grana_widget_card"
    android:orientation="vertical"
    android:padding="10dp">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="4dp"
      android:text="@string/grana_central_titulo"
      android:textColor="@color/grana_widget_menta"
      android:textSize="10sp"
      android:letterSpacing="0.04"
      android:textAllCaps="true"
      android:maxLines="1" />

  <TextView
      android:id="@+id/grana_central_entrada"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:drawableStart="@drawable/ic_grana_widget_entrada"
      android:drawablePadding="8dp"
      android:paddingHorizontal="2dp"
      android:text="@string/grana_central_entrada"
      android:textColor="@color/grana_widget_texto"
      android:textSize="13sp"
      android:maxLines="1" />

  <TextView
      android:id="@+id/grana_central_saida"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:drawableStart="@drawable/ic_grana_widget_saida"
      android:drawablePadding="8dp"
      android:paddingHorizontal="2dp"
      android:text="@string/grana_central_saida"
      android:textColor="@color/grana_widget_texto"
      android:textSize="13sp"
      android:maxLines="1" />

  <TextView
      android:id="@+id/grana_central_credito"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:drawableStart="@drawable/ic_grana_widget_credito"
      android:drawablePadding="8dp"
      android:paddingHorizontal="2dp"
      android:text="@string/grana_central_credito"
      android:textColor="@color/grana_widget_texto"
      android:textSize="13sp"
      android:maxLines="1" />

  <TextView
      android:id="@+id/grana_central_boleto"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:drawableStart="@drawable/ic_grana_widget_boleto"
      android:drawablePadding="8dp"
      android:paddingHorizontal="2dp"
      android:text="@string/grana_central_boleto"
      android:textColor="@color/grana_widget_texto"
      android:textSize="13sp"
      android:maxLines="1" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Barra horizontal, 4 botões-pílula lado a lado (pedido de 05/09/2026).
     Cada pílula agora tem um selo circular CHEIO em volta do ícone — mesma
     receita de habitoIcone (app/index.tsx: círculo sólido + glifo simples
     dentro, sem contorno no ícone) — antes cada ícone tentava desenhar seu
     próprio círculo de contorno, inconsistente entre os 4 e "muito ruim"
     por retrato do autor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grana_central_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grana_widget_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

  <LinearLayout
      android:id="@+id/grana_central_entrada"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/grana_widget_acao">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/grana_widget_selo"
        android:src="@drawable/ic_grana_widget_entrada"
        android:padding="5dp"
        android:scaleType="centerInside" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/grana_central_entrada"
        android:textColor="@color/grana_widget_texto"
        android:textSize="9.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/grana_central_saida"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginStart="6dp"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/grana_widget_acao">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/grana_widget_selo"
        android:src="@drawable/ic_grana_widget_saida"
        android:padding="5dp"
        android:scaleType="centerInside" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/grana_central_saida"
        android:textColor="@color/grana_widget_texto"
        android:textSize="9.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/grana_central_credito"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginStart="6dp"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/grana_widget_acao">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/grana_widget_selo"
        android:src="@drawable/ic_grana_widget_credito"
        android:padding="5dp"
        android:scaleType="centerInside" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/grana_central_credito"
        android:textColor="@color/grana_widget_texto"
        android:textSize="9.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/grana_central_boleto"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginStart="6dp"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/grana_widget_acao">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/grana_widget_selo"
        android:src="@drawable/ic_grana_widget_boleto"
        android:padding="5dp"
        android:scaleType="centerInside" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/grana_central_boleto"
        android:textColor="@color/grana_widget_texto"
        android:textSize="9.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>
</LinearLayout>

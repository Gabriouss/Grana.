<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grana_central_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grana_widget_card"
    android:orientation="vertical"
    android:padding="10dp">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="6dp"
      android:text="@string/grana_central_titulo"
      android:textColor="@color/grana_widget_texto"
      android:textSize="12sp"
      android:textStyle="bold"
      android:maxLines="1" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/grana_central_entrada"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="3dp"
        android:background="@drawable/grana_widget_acao"
        android:drawableTop="@drawable/ic_grana_widget_entrada"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:text="@string/grana_central_entrada"
        android:textColor="@color/grana_widget_texto"
        android:textSize="10sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/grana_central_saida"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:background="@drawable/grana_widget_acao"
        android:drawableTop="@drawable/ic_grana_widget_saida"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:text="@string/grana_central_saida"
        android:textColor="@color/grana_widget_texto"
        android:textSize="10sp"
        android:maxLines="1" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="6dp"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/grana_central_credito"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="3dp"
        android:background="@drawable/grana_widget_acao"
        android:drawableTop="@drawable/ic_grana_widget_credito"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:text="@string/grana_central_credito"
        android:textColor="@color/grana_widget_texto"
        android:textSize="10sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/grana_central_boleto"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:background="@drawable/grana_widget_acao"
        android:drawableTop="@drawable/ic_grana_widget_boleto"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:text="@string/grana_central_boleto"
        android:textColor="@color/grana_widget_texto"
        android:textSize="10sp"
        android:maxLines="1" />
  </LinearLayout>
</LinearLayout>

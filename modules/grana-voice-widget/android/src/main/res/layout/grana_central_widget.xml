<?xml version="1.0" encoding="utf-8"?>
<!-- 06/09/2026: trocado de "1 cartão único com 4 colunas empilhadas (ícone
     em cima, rótulo embaixo, dentro de uma faixa com fundo próprio)" pra "4
     cápsulas separadas lado a lado, ícone ao lado do rótulo" — pedido do
     autor pra igualar o formato real da fileira "Colar comprovante"/
     "Importar extrato"/"Escanear nota" (app/(app)/index.tsx,
     styles.smartActionBtn), só trocando a descrição/função pelas 4 de
     lançamento (Entrada/Débito-Pix/Crédito/Boleto). Por isso o elemento
     raiz não tem mais fundo/borda próprios — quem desenha cápsula agora é
     cada botão (grana_widget_acao, raio 999dp), com folga entre eles pra
     aparecer o papel de parede, igual à referência. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grana_central_raiz"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="2dp">

  <LinearLayout
      android:id="@+id/grana_central_entrada"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:gravity="center"
      android:paddingHorizontal="6dp"
      android:background="@drawable/grana_widget_acao">
    <ImageView
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_grana_widget_entrada"
        android:scaleType="centerInside" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/grana_central_entrada"
        android:textColor="@color/grana_widget_texto"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/grana_central_saida"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_weight="1"
      android:layout_marginStart="5dp"
      android:orientation="horizontal"
      android:gravity="center"
      android:paddingHorizontal="6dp"
      android:background="@drawable/grana_widget_acao">
    <ImageView
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_grana_widget_saida"
        android:scaleType="centerInside" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/grana_central_saida"
        android:textColor="@color/grana_widget_texto"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/grana_central_credito"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_weight="1"
      android:layout_marginStart="5dp"
      android:orientation="horizontal"
      android:gravity="center"
      android:paddingHorizontal="6dp"
      android:background="@drawable/grana_widget_acao">
    <ImageView
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_grana_widget_credito"
        android:scaleType="centerInside" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/grana_central_credito"
        android:textColor="@color/grana_widget_texto"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/grana_central_boleto"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_weight="1"
      android:layout_marginStart="5dp"
      android:orientation="horizontal"
      android:gravity="center"
      android:paddingHorizontal="6dp"
      android:background="@drawable/grana_widget_acao">
    <ImageView
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_grana_widget_boleto"
        android:scaleType="centerInside" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/grana_central_boleto"
        android:textColor="@color/grana_widget_texto"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>
</LinearLayout>

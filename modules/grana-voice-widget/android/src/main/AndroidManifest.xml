<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Gravar do widget exige as três: o microfone em si, o serviço em primeiro
       plano e o subtipo `microphone`, obrigatório a partir do Android 14 pra
       um serviço que captura áudio. Sem o subtipo o sistema derruba o serviço
       com SecurityException assim que ele sobe. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>

    <!-- AppWidgetManager e PendingIntents explícitos continuam entregando os
         eventos com receivers privados. Assim nenhum outro app pode forjar o
         TOQUE e iniciar a captura do microfone. -->
    <receiver
      android:name="com.gabriouss.grana.voicewidget.GranaVoiceWidgetProvider"
      android:label="@string/grana_voice_widget_rotulo"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <intent-filter>
        <action android:name="com.gabriouss.grana.voicewidget.TOQUE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/grana_voice_widget_info" />
    </receiver>

    <receiver
      android:name="com.gabriouss.grana.voicewidget.LivreParaGastarWidgetProvider"
      android:label="@string/grana_livre_widget_rotulo"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.DATE_CHANGED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/grana_livre_widget_info" />
    </receiver>

    <receiver
      android:name="com.gabriouss.grana.voicewidget.CentralLancamentoWidgetProvider"
      android:label="@string/grana_central_widget_rotulo"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/grana_central_widget_info" />
    </receiver>

    <receiver
      android:name="com.gabriouss.grana.voicewidget.ProximoCompromissoWidgetProvider"
      android:label="@string/grana_compromisso_widget_rotulo"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.DATE_CHANGED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/grana_compromisso_widget_info" />
    </receiver>

    <receiver
      android:name="com.gabriouss.grana.voicewidget.CofrinhoWidgetProvider"
      android:label="@string/grana_cofrinho_widget_rotulo"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.DATE_CHANGED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/grana_cofrinho_widget_info" />
    </receiver>

    <service
      android:name="com.gabriouss.grana.voicewidget.GranaVoiceCaptureService"
      android:foregroundServiceType="microphone"
      android:exported="false" />

    <!-- Sem `exported`: quem inicia é sempre o serviço de captura, no mesmo
         processo. -->
    <service
      android:name="com.gabriouss.grana.voicewidget.GranaVoiceHeadlessService"
      android:exported="false" />

  </application>
</manifest>

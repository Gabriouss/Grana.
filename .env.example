# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados do
# SEU projeto Supabase: Project Settings -> API -> Project URL / anon public key.
# O arquivo ".env" já está no .gitignore — nunca vai parar no controle de versão.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# Número do WhatsApp Business (Meta Cloud API) que recebe os lançamentos por
# mensagem — só para exibir a instrução de pareamento na tela de Perfil.
# O número em si (e o webhook) é configurado à parte, no Meta App Dashboard e
# nos secrets da Edge Function supabase/functions/whatsapp-webhook — ver o
# comentário no topo daquele arquivo.
EXPO_PUBLIC_WHATSAPP_NUMBER=+55 11 00000-0000

# URL HTTPS do checkout de assinatura. Enquanto estiver vazia, a tela de
# assinatura aponta para a seção de preços da landing e o bloqueio
# server-side deve permanecer desligado.
#
# O nome não cita provedor de propósito: a plataforma mudou de Kiwify para
# Cakto e pode mudar de novo. O app ainda LÊ os nomes antigos como queda, para
# uma build ou ambiente já configurado não parar de vender no dia da troca —
# a queda pode sair quando Vercel e EAS estiverem com os nomes novos.
EXPO_PUBLIC_CHECKOUT_URL=https://pay.cakto.com.br/esgddv2_1096987

# URL HTTPS do checkout do plano ANUAL. Sem ela, o app e a landing mostram
# apenas o plano mensal — nada quebra, só deixa de existir a opção anual.
# A oferta anual é cadastrada por R$ 0,99 a menos que o preço anunciado,
# porque a Cakto soma essa taxa de serviço fixa e cobra do comprador.
EXPO_PUBLIC_CHECKOUT_URL_ANUAL=https://pay.cakto.com.br/323b2rs

# Opcional: URL HTTPS de gerenciamento/atualização da cobrança. Sem ela, o app
# orienta a pessoa a usar o link recebido no e-mail da compra e oferece
# contato com o suporte, sem abrir um segundo checkout para assinaturas
# atrasadas.
EXPO_PUBLIC_BILLING_URL=

# Segredo do webhook da Cakto, conferido pela Edge Function `cakto-webhook`.
# ATENÇÃO: a Cakto envia este valor DENTRO do corpo JSON, não como assinatura
# em header. Qualquer log do corpo vaza o segredo — por isso a função nunca
# registra o payload. É segredo de Edge Function, não variável EXPO_PUBLIC.
# CAKTO_WEBHOOK_SECRET=

# URL HTTPS estável do APK oficial. Use um endereço controlado pelo Grana.,
# não o link temporário de um artefato do EAS. Exemplo:
# https://granaponto.com.br/downloads/grana-latest.apk
EXPO_PUBLIC_ANDROID_DOWNLOAD_URL=https://granaponto.com.br/downloads/grana-latest.apk

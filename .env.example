# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados do
# SEU projeto Supabase: Project Settings -> API -> Project URL / anon public key.
# O arquivo ".env" já está no .gitignore — nunca vai parar no controle de versão.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# Número do WhatsApp Business (Meta Cloud API) que recebe os lançamentos por
# mensagem — só para exibir a instrução de pareamento na tela de Perfil.
# O número em si (e o webhook) é configurado à parte, no Meta App Dashboard e
# nos secrets da Edge Function supabase/functions/whatsapp-webhook — ver o
# comentário no topo daquele arquivo.
EXPO_PUBLIC_WHATSAPP_NUMBER=+55 11 00000-0000

# URL HTTPS do checkout publicado na Kiwify. Enquanto estiver vazia, a tela
# de assinatura aponta para a seção de preços da landing e o bloqueio
# server-side deve permanecer desligado.
EXPO_PUBLIC_KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/SEU-CHECKOUT

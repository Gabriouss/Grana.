{
  "expo": {
    "name": "Grana.",
    "slug": "grana-app",
    "scheme": ["granaapp", "grana"],
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gabriouss.grana",
      "adaptiveIcon": {
        "backgroundColor": "#052229",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withGradleSafeProjectName",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#052229",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#052229"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que o Grana. use o microfone para lançar despesas por voz.",
          "speechRecognitionPermission": "Permitir que o Grana. transcreva sua voz para preencher o lançamento."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Grana. use a câmera para ler o QR Code de notas fiscais."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#052229",
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ef78d72-9cec-473a-98f8-5d8e67f01e70"
      }
    },
    "owner": "gabriouss"
  }
}

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (mantém .env.example versionado, com placeholders)
.env
.env*.local

# typescript
*.tsbuildinfo

# material de suporte recebido de usuários (prints, relatos) — contém dado
# financeiro de terceiro e o repositório é público: nunca versionar
Feedbacks/
Screenshots/

# logs de sessão local do dev server
.expo-start.log
.expo-web.log

# generated native folders
/ios
/android

# metadados locais do `supabase link` (ref do projeto, URLs internas) — não é segredo, mas é estado da máquina, não do repositório
supabase/.temp/

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (mantém .env.example versionado, com placeholders)
.env
.env*.local

# typescript
*.tsbuildinfo

# material de suporte recebido de usuários (prints, relatos) — contém dado
# financeiro de terceiro e o repositório é público: nunca versionar
Feedbacks/
Screenshots/

# subproduto de rodar `deno check` nas Edge Functions localmente — o deploy
# pelo CLI do Supabase não usa este arquivo, então versioná-lo só cria ruído
# e risco de conflito quando as duas máquinas checarem em versões diferentes
deno.lock

# logs de sessão local do dev server
.expo-start.log
expo-start.log
expo-start.err.log
.expo-web.log

# generated native folders
/ios
/android

# metadados locais do `supabase link` (ref do projeto, URLs internas) — não é segredo, mas é estado da máquina, não do repositório
supabase/.temp/

# configuração local do Claude Code (hooks, permissões) — por convenção do
# próprio Claude Code é por-máquina, não compartilhada entre as duas máquinas
.claude/settings.local.json

# Configuracao de servidor MCP com escopo de PROJETO. O `claude mcp add` grava
# as credenciais em texto puro aqui quando alguem passa `-s project`. O padrao
# do comando e escopo local, que vai para ~/.claude.json e fica fora do repo —
# mas basta uma flag para o segredo cair aqui dentro. Em 10/09/2026 o MCP da
# Cakto foi adicionado com credencial de ESCRITA em producao; se aquilo tivesse
# ido para o escopo de projeto, teria virado commit publico.
.mcp.json

# Temporarios do Google Drive Desktop, que sincroniza esta pasta
.tmp.driveupload/
.tmp.drivedownload/
